{
  // Fedora logo in black and white. Replace USERNAME with your user name.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/USERNAME/.config/fastfetch/fedora-logo.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "────────────────────────────────"
    },
    "os",
    "kernel",
    "datetime",
    "uptime",
    "packages",
    "shell",
    "break",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "break",
    "host",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip"
  ]
}
