{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "/home/iko/.config/fastfetch/fedora-logo.png",
    "width": 36,
    "height": 21,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " :: ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    },
    "key": {
      "width": 4
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌────────────────── Hardware Info ──────────────────┐"
    },
    "break",
    {
      "type": "host",
      "key": "  "
    },
    {
      "type": "cpu",
      "key": "  "
    },
    {
      "type": "gpu",
      "key": " 󰢮 "
    },
    {
      "type": "memory",
      "key": "  "
    },
    {
      "type": "disk",
      "key": " 󰋊 "
    },
    {
      "type": "display",
      "key": " 󰍹 "
    },
    "break",
    {
      "type": "custom",
      "format": "├────────────────── Software Info ──────────────────┤"
    },
    "break",
    {
      "type": "os",
      "key": "  "
    },
    {
      "type": "kernel",
      "key": "  "
    },
    {
      "type": "wm",
      "key": "  "
    },
    {
      "type": "datetime",
      "key": " 󰃰 "
    },
    {
      "type": "shell",
      "key": "  "
    },
    {
      "type": "packages",
      "key": " 󰏖 "
    },
    "break",
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────────────┘"
    }
  ]
}
