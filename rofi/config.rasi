/* rofi config for noir: application launcher, black and white */

configuration {
    modi:                 "drun,run";
    show-icons:           true;
    display-drun:         "apps";
    display-run:          "run";
    drun-display-format:  "{name}";
    hover-select:         true;
}

@theme "~/.config/rofi/noir.rasi"
