/* noir: black card, white text, inverted selection */

* {
    void:       #000000;
    surface:    #0c0c0c;
    hairline:   #242424;
    ink:        #f4f4f4;
    ink-muted:  #7d7d7d;

    font:       "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @ink;
}

window {
    location:         center;
    width:            36%;
    padding:          14px;
    background-color: @void;
    border:           1px;
    border-color:     @hairline;
    border-radius:    16px;
}

mainbox {
    spacing:  12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @surface;
    border:           1px;
    border-color:     @hairline;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color: @ink-muted;
}

entry {
    placeholder:       "search";
    placeholder-color: @ink-muted;
}

listview {
    lines:        8;
    spacing:      4px;
    scrollbar:    false;
    fixed-height: false;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @ink;
}

element selected.normal {
    background-color: @ink;
    text-color:       @void;
}

element-icon {
    size: 22px;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
