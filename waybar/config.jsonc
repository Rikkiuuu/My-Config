{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,

  "modules-center": [
    "clock",
    "mango/workspaces",
    "custom/cava",
    "mpris",
    "pulseaudio",
    "network",
    "tray",
    "custom/power"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "mango/workspaces": {
    "format": "{index}",
    "disable-markup": true,
    "on-click": "activate",
    "on-click-right": "toggle",
    "overview-label": "OVERVIEW"
  },

   "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-len": 29,
    "player-icons": { "default": "" },
    "status-icons": { "paused": "" }
  },

  "custom/cava": {
    "exec": "~/.config/waybar/cava.sh",
    "format": "{}"
  },


  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " eth",
    "format-disconnected": " off",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
