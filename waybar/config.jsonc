// ~/.config/waybar/config.jsonc
// Black "island" bar: floating pills, mango tags in the middle.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["clock", "mpris"],
  "modules-center": ["mango/workspaces"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/power"],

  "mango/workspaces": {
    "format": "{index}",
    "disable-markup": true,
    "on-click": "activate",
    "on-click-right": "toggle",
    "overview-label": "OVERVIEW"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-len": 36,
    "player-icons": { "default": "▶" },
    "status-icons": { "paused": "⏸" }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "muted",
    "format-icons": { "default": ["🔈", "🔉", "🔊"] },
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },

  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}% ⚡",
    "format-plugged": "{capacity}%",
    "states": { "warning": 25, "critical": 10 }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
